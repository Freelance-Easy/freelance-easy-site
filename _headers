# Cloudflare headers (Workers Static Assets honours the Pages format)
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Long-cache fonts (filenames are immutable enough for a year)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Product imagery and the loop keep their filenames across refinements, so a
# day, then revalidate (an ETag 304 when unchanged), not a month.
/assets/screenshots/*
  Cache-Control: public, max-age=86400, must-revalidate
/assets/video/*
  Cache-Control: public, max-age=86400, must-revalidate

# Everything else in assets/ (logo, OG image, sample PDFs): a month
/assets/*
  Cache-Control: public, max-age=2592000

# CSS/JS revalidate on every load (an ETag 304 when unchanged), so a deploy
# shows on a plain reload. An hour of max-age left returning visitors on the
# old stylesheet against new HTML.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/script.js
  Cache-Control: public, max-age=0, must-revalidate

# Short-cache favicon so logo updates ship within a day
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

# Campaign landing pages are for ads, not search.
/mac-audio
  X-Robots-Tag: noindex
/audio
  X-Robots-Tag: noindex
