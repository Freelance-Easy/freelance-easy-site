# Cloudflare headers (Workers Static Assets honours the Pages format)
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Rules STACK: every matching rule contributes, in file order, and a header set
# twice is sent twice (seen live: "max-age=2592000, ..., max-age=86400"). So the
# broad assets/ rule comes first and each narrower rule detaches ("! Header")
# its Cache-Control before setting its own.

# Everything in assets/ (logo, OG image): a month
/assets/*
  Cache-Control: public, max-age=2592000

# Long-cache fonts (filenames are immutable enough for a year)
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Product imagery and the loop keep their filenames across refinements, so a
# day, then revalidate (an ETag 304 when unchanged), not a month.
/assets/screenshots/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/assets/video/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
# The sample PDFs are re-rendered with the hero sheets under the same names
# (they moved to the G11 demo data on 2026-10-05), so the same day.
/assets/samples/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

# The scroll-story homepage (2026-10-08). Its CSS/JS keep their names across
# deploys, so they revalidate on every load like styles.css and script.js; the
# stills and the invoice paper a day, then revalidate; its fonts a year.
/assets/story/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/assets/story/static/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/assets/story/paper/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/assets/story/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS revalidate on every load (an ETag 304 when unchanged), so a deploy
# shows on a plain reload. An hour of max-age left returning visitors on the
# old stylesheet against new HTML.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/script.js
  Cache-Control: public, max-age=0, must-revalidate

# Short-cache favicon so logo updates ship within a day
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

# Campaign landing pages are for ads, not search.
/mac-audio
  X-Robots-Tag: noindex
/audio
  X-Robots-Tag: noindex

# The tours (2026-10-08). Outside assets/, so their HTML/CSS/JS get the
# platform default (revalidate every load); only the fonts are long-cached.
/tour/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# The 25-second tour is an embed (the homepage's dialog), not a page for search.
# The splat also matches /tour/quick/ itself.
/tour/quick/*
  X-Robots-Tag: noindex
