# Cloudflare Pages redirects
# Format: <source> <destination> <status>
#
# This file is the SINGLE source of truth for download URLs.
# index.html buttons point at /download/win and /download/mac (relative);
# Cloudflare resolves them here. When a new version ships, edit ONLY
# the lines below — never the HTML.

# === Windows ===
# Stable filename — IG's electron-builder artifactName is now version-less
# (set in electron/package.json), so this URL never needs updating per
# release. New releases just become the new "latest" on GitHub Releases.
/download/win   https://github.com/Freelance-Easy/InvoiceGenerator-releases/releases/latest/download/Freelance-Easy-Setup.exe   302

# === Mac ===
# Apple Silicon arm64 .dmg, signed + notarized via Apple Developer Program
# (approved 2026-05-08, first DMG shipped v0.2.13-beta on 2026-05-09).
# Stable filename via electron/package.json artifactName "${productName}.${ext}"
# — same convention as Windows. URL never moves per release; new versions
# become the new "latest" on GitHub Releases.
/download/mac   https://github.com/Freelance-Easy/InvoiceGenerator-releases/releases/latest/download/Freelance-Easy.dmg   302

# === General ===
/download       https://github.com/Freelance-Easy/InvoiceGenerator-releases/releases   302
/releases       https://github.com/Freelance-Easy/InvoiceGenerator-releases/releases   302

# Pretty URLs for the placeholder pages (Cloudflare Pages serves /privacy.html
# automatically, but this catches /privacy/ with a trailing slash).
/privacy/   /privacy   301
/terms/     /terms     301
